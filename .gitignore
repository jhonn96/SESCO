# Entornos virtuales de Python
venv/
.venv/
env/

# Caché de Python
__pycache__/
*.pyc

# Variables de entorno (¡Nunca subas tu .env real!)
.env
.env.*
!.env.example

# Node (para tu frontend React)
node_modules/
dist/
build/

# Base de datos (si no quieres versionar el volcado local)
*.sql

# Las migraciones sí se versionan (el volcado local no)
!backend/migrations/*.sql