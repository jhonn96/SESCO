# Copia este archivo como `.env` dentro de backend/ y ajusta los valores.
# Ninguna de estas variables debe versionarse con datos reales.

# --- Aplicación ---
APP_NAME=SESCO API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# --- PostgreSQL 16 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sesco
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public

# --- Seguridad / JWT ---
JWT_SECRET=generar-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- SQLAlchemy ---
SQL_ECHO=false

# --- Tareas programadas ---
# Cierre automático de jornada (salidas sin escaneo) cada N minutos.
CIERRE_JORNADA_AUTOMATICO=true
CIERRE_JORNADA_INTERVALO_MIN=15
# Alertas automáticas al final del día (cursos sin registro de asistencia).
ALERTAS_CIERRE_AUTOMATICO=true
ALERTAS_CIERRE_HORA=19
